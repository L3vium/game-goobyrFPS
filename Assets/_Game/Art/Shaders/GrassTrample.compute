// Author : Baptiste Vu Liem
// The grass trample texture (World/GrassTrample.cs): a window of the ground round the camera, one texel
// per 25 cm. Each frame the window follows the camera (texels shift with it), what was pressed stands
// back up a little, and every walker, NPC and dropped item presses again: xy = push (away from the
// walker, along its stride), z = how flat (1 under it).
#pragma kernel Update

Texture2D<float4> _Previous;
RWTexture2D<float4> _Current;
StructuredBuffer<float4> _Sources;  // 2 per source: (x, y, z, radius), (stride x, stride z, strength, 0)
uint _SourceCount;
uint _Size;
float4 _Window;                     // x, z of the window's corner, texel size (m), what is left of the press this frame
int4 _Shift;                        // texels the window moved since last frame (x, z)

[numthreads(8, 8, 1)]
void Update(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size || id.y >= _Size) return;
    int2 lFrom = int2(id.xy) + _Shift.xy;
    float4 v = 0.0;
    if (all(lFrom >= 0) && all(lFrom < (int)_Size)) v = _Previous[lFrom];
    v.xyz *= _Window.w;

    float2 p = _Window.xy + (float2(id.xy) + 0.5) * _Window.z;
    for (uint i = 0; i < _SourceCount; i++)
    {
        float4 s = _Sources[i * 2];
        float4 m = _Sources[i * 2 + 1];
        float2 d = p - s.xz;
        float lDistance = length(d);
        if (lDistance >= s.w) continue;
        float k = 1.0 - lDistance / s.w;
        k = k * k * (3.0 - 2.0 * k) * m.z;
        float2 lAway = lDistance > 0.001 ? d / lDistance : float2(0.0, 0.0);
        float2 lPush = (lAway + m.xy * 0.6) * k;
        v.xy = k > v.z ? lPush : v.xy + lPush * 0.25;
        v.z = max(v.z, k);
    }
    float lLength = length(v.xy);
    if (lLength > 1.0) v.xy /= lLength;
    _Current[id.xy] = v;
}

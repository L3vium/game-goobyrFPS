# Hitmen — Unreal Engine 5.7

# Generated by the engine / IDE (anchored to the root so packaged builds keep their Binaries)
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcworkspace
*.xcodeproj

# Plugin build output
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Packaged builds: only the archived player builds are versioned
Build/
Builds/**/Saved/
Builds/**/Manifest_*.txt
Builds/**/*.pdb
# Packaging temp folders and the per-version symbol archive (Tools/Packaging/package_builds.ps1)
Builds/_*/
!Builds/Windows/
!Builds/Windows Dev/

# Cooked content and caches
*.pdb.tmp
*.ilk
*.ipch
StagedBuilds/
ArchivedBuilds/

# OS / tools
Thumbs.db
.DS_Store
*.tmp
*.log
__pycache__/
*.pyc
